{
  "name": "fantasy-tower-defense",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "enemies": "vite --open /#enemies",
    "champions": "vite --open /#champions",
    "stages": "vite --open /#stages",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx",
    "typecheck": "tsc -b --noEmit",
    "balance": "node tools/balance-sim/run.mjs",
    "editor": "vite --config tools/editor/vite.config.mjs",
    "editor:build": "tsc -p tools/editor/tsconfig.json && vite build --config tools/editor/vite.config.mjs",
    "editor:preview": "vite preview --config tools/editor/vite.config.mjs",
    "editor:check": "node tools/editor/scripts/check.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.186.0",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.21.5",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
